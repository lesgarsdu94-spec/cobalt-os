# ============================================================================
# NovaTech Cobalt OS - .gitignore configuration
# ============================================================================

# Prerequisites: Global C template defaults
*.o
*.obj
*.a
*.la
*.lo

# OS Kernel Binaries & Final Images
*.bin
*.elf
*.sys
*.iso
*.img
*.flp

# GitHub Actions Artifacts & Cache
.artifacts/
build/
dist/

# Android Emulator Log Files (QEMU / Bochs / Limbo)
*.log
bochsout.txt
qemu-vga.log

# System-generated metadata (Android / macOS / Windows)
.DS_Store
Thumbs.db
.directory
.vscode/
.idea/
